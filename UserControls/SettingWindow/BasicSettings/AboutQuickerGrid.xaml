<UserControl
    xmlns:local="clr-namespace:Quicker.UserControls.SettingWindow.BasicSettings"
    x:Class="Quicker.UserControls.SettingWindow.BasicSettings.AboutQuickerGrid"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"

    d:DesignHeight="870"
    d:DesignWidth="982"

    Unloaded="AboutQuickerGrid_Unloaded"
>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="952*"/>
        </Grid.ColumnDefinitions>
        <!-- 基础设置-关于Quicker-关于Quicker -->
        <Button x:Name="AboutQuickerButton" Content="关于Quicker" ToolTip="基础信息" Style="{StaticResource Button3}" Margin="1,14,0,0" Width="99" Click="AboutQuickerButton_Click" Grid.Column="1" BorderThickness="0,0,0,2"/>
        <Grid x:Name="AboutQuickerButtonGrid" Margin="10,43,0,0" Visibility="Visible" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="647*"/>
                <ColumnDefinition Width="300*"/>
            </Grid.ColumnDefinitions>
            <Image HorizontalAlignment="Left" Height="48" Margin="4,12,0,0" VerticalAlignment="Top" Width="48" Source="/Resources/Images/Quicker_Enabled.png"/>
            <Label Content="Quicker" HorizontalAlignment="Left" Margin="57,16,0,0" VerticalAlignment="Top" FontSize="24" FontWeight="Bold"/>
            <Label x:Name="VersionLabel" Content="版本：" HorizontalAlignment="Left" Margin="4,65,0,0" VerticalAlignment="Top" FontSize="16"/>
            <TextBlock x:Name="UpdateHistory" Style="{StaticResource HoverTextBlock}" Text="更新历史" Margin="109,70,0,0" FontSize="16" MouseLeftButtonDown="OpenUpdateHistory">
                <TextBlock.ToolTip>
                    <ToolTip Content="点击查看" FontSize="12" Foreground="Black"/>
                </TextBlock.ToolTip>
            </TextBlock>
            <!-- 开发团队 -->
            <GroupBox Header="开发团队" Style="{StaticResource SettingGroupBox}" Margin="10,106,0,0">
                <Grid>
                    <Label Content="策划、代码、美术：@Anonymity" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Label Content="美术协助、代码协助：@墨分璃" HorizontalAlignment="Left" Margin="0,28,0,0" VerticalAlignment="Top"/>
                    <Label Content="测试：@巍巍噻" HorizontalAlignment="Left" Margin="0,56,0,0" VerticalAlignment="Top"/>
                </Grid>
            </GroupBox>
            <!-- 特别感谢 -->
            <GroupBox Header="特别感谢" Style="{StaticResource SettingGroupBox}" Margin="10,245,0,0">
                <Grid>
                    <Label Content="特别感谢给予Quicker各种支持的朋友们。" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Label Content="正是因为你们，Quicker才可以存在并不断进步！" HorizontalAlignment="Center" Margin="0,28,0,0" VerticalAlignment="Top"/>
                </Grid>
            </GroupBox>
            <!-- 数据文件夹 -->
            <GroupBox Header="数据文件夹" Style="{StaticResource SettingGroupBox}" Margin="10,397,0,0">
                <Grid>
                    <Button x:Name="ChangeDataFolderButton" Content="更改..." ToolTip="更改应用数据存储路径" HorizontalAlignment="Left" Style="{StaticResource WhiteButton}" Margin="85,2,0,0" VerticalAlignment="Top" Width="60" Click="ChangeDataFolderButton_Click" FontSize="12"/>

                    <Label Content="根文件夹：" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBlock x:Name="RootFolderPath" Style="{StaticResource HoverTextBlock}" ToolTip="打开文件夹" Margin="18,28,0,0" FontSize="12" MouseDown="RootFolderPath_MouseDown"/>
                    <Label Content="数据库文件夹：" HorizontalAlignment="Left" Margin="0,49,0,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="DatabaseFolderPath" Style="{StaticResource HoverTextBlock}" ToolTip="打开文件夹" Margin="18,77,0,0" FontSize="12" MouseDown="DatabaseFolderPath_MouseDown"/>
                    <Label Content="图标文件夹：" HorizontalAlignment="Left" Margin="0,98,0,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="LocalIconsFolderPath" Style="{StaticResource HoverTextBlock}" ToolTip="打开文件夹" Margin="18,126,0,0" FontSize="12" MouseDown="LocalIconsFolderPath_MouseDown"/>
                </Grid>
            </GroupBox>
            <!-- 备份数据 -->
            <GroupBox Header="备份数据" Style="{StaticResource SettingGroupBox}" Margin="10,583,0,0">
                <Grid>
                    <Button x:Name="BackupDataButton" Style="{StaticResource WhiteButton}" Content="备份全部数据" HorizontalAlignment="Left" VerticalAlignment="Top" Click="BackupDataButton_Click" Width="88" FontSize="12"/>
                    <Label Content="仅作为备份用途，不支持导入。" HorizontalAlignment="Center" Margin="0,24,0,0" VerticalAlignment="Top" FontSize="10" Foreground="#FFB4B4B4"/>
                </Grid>
            </GroupBox>
            <!-- 临时文件 -->
            <GroupBox Header="临时文件" Style="{StaticResource SettingGroupBox}" Margin="10,669,0,0">
                <Grid>
                    <Label Content="大小：" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBlock x:Name="TempSize" HorizontalAlignment="Left" Margin="57,5,0,0" Text="计算中..." VerticalAlignment="Top"/>
                    <Button x:Name="CleanTempDataButton" Content="清理" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="0,28,0,0" VerticalAlignment="Top" Width="60" Click="CleanTempDataButton_Click" IsEnabled="False" FontSize="12"/>
                </Grid>
            </GroupBox>

            <!-- 第三方组件 -->
            <GroupBox Header="第三方组件" Style="{StaticResource SettingGroupBox}" Margin="10,10,0,0" Grid.Column="1">
                <Grid>
                    <Button x:Name="ViewOpenSourceButton" Style="{StaticResource WhiteButton}" Content="查看开源组件及许可协议信息" Margin="10,10,0,0" VerticalAlignment="Top" Width="167" Foreground="#468FFC" Click="ViewOpenSourceButton_Click" FontSize="12" HorizontalAlignment="Left"/>
                    <GroupBox Header="图标资源" Style="{StaticResource LinkGroupBox}" Margin="5,45,0,0">
                        <Grid>
                            <TextBlock x:Name="www_iconfont_cn" ToolTip="点击前往" Style="{StaticResource HoverTextBlock}" Text="www.iconfont.cn" MouseLeftButtonDown="www_iconfont_cn_MouseLeftButtonDown" Margin="5,0,0,0"/>
                            <TextBlock x:Name="fontawesome_com" ToolTip="点击前往" Style="{StaticResource HoverTextBlock}" Margin="5,18,0,0" Text="Font Awesome" MouseLeftButtonDown="fontawesome_com_MouseLeftButtonDown"/>
                            <TextBlock x:Name="icons8_com" ToolTip="点击前往" Style="{StaticResource HoverTextBlock}" Text="icons8.com" MouseLeftButtonDown="icons8_com_MouseLeftButtonDown" Margin="5,36,0,0"/>
                            <TextBlock x:Name="icon11_community_github_io" Style="{StaticResource HoverTextBlock}" ToolTip="点击前往" Margin="5,54,0,0" Text="icon11-community.github.io" MouseLeftButtonDown="icon11_community_github_io_MouseLeftButtonDown"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </GroupBox>
            <!-- 支持 -->
            <GroupBox Header="支持" Style="{StaticResource SettingGroupBox}" Margin="10,203,0,0" Grid.Column="1">
                <Grid>
                    <TextBlock x:Name="FeedBack" ToolTip="点击前往" Style="{StaticResource HoverTextBlock}" Text="BUG反馈、需求" MouseLeftButtonDown="FeedBack_MouseLeftButtonDown" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </GroupBox>
            <!-- 入正 -->
            <GroupBox Header="入正" Style="{StaticResource SettingGroupBox}" Margin="10,268,0,0" Grid.Column="1">
                <Grid>
                    <TextBlock x:Name="getquicker_net" ToolTip="前往正版Quicker官网" Style="{StaticResource HoverTextBlock}" Text="getquicker.net" MouseLeftButtonDown="getquicker_net_MouseLeftButtonDown" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 基础设置-关于Quicker-隐私声明 -->
        <Button x:Name="Privacy_StatementButton" Content="隐私声明" ToolTip="隐私声明" Style="{StaticResource Button3}" Margin="100,14,0,0" Width="74" Click="Privacy_StatementButton_Click" BorderThickness="0" Grid.Column="1"/>
        <Grid x:Name="Privacy_StatementButtonGrid" Margin="10,43,317,0" Visibility="Hidden" Grid.ColumnSpan="2">
            <Label Content="键盘钩子(HOOK):" HorizontalAlignment="Left" Margin="16,43,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16"/>
            <Label Content="隐私声明" HorizontalAlignment="Left" Margin="5,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="18"/>
            <Label Content="本软件会使用全局键盘钩子(HOOK)判断按键状态，实现激活面板、扩展热键和文本指令等功能。&#xD;&#xA;安全软件可能会因此弹出安全提示。&#xD;&#xA;本软件不会监听和记录您的普通按键输入，也不会将这些输入内容发送到网络，请放心使用。" HorizontalAlignment="Left" Margin="27,73,0,0" VerticalAlignment="Top" FontSize="14"/>
        </Grid>
    </Grid>
</UserControl>