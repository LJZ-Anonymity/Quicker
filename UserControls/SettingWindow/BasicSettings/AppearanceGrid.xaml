<UserControl
    xmlns:local="clr-namespace:Quicker.UserControls.SettingWindow.BasicSettings"
    x:Class="Quicker.UserControls.SettingWindow.BasicSettings.AppearanceGrid"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:setting="clr-namespace:Quicker.UserControls.SettingWindow"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DataContext="{d:DesignInstance Type=local:AppearanceGrid}"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:styles="clr-namespace:Quicker.Resources.Styles"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:conv="clr-namespace:Quicker.Converters"
    xmlns:helpers="clr-namespace:Quicker.Helpers"
    mc:Ignorable="d"

    d:DesignHeight="1200"
    d:DesignWidth="982"

    Unloaded="AppearanceGrid_Unloaded"
>
    <UserControl.Resources>
        <conv:SmartHoverColorConverter x:Key="SmartHoverColorConverter" DarkerFactor="0.8" LighterFactor="1.2"/>
        <conv:PathToImageSourceConverter x:Key="PathToImageSourceConverter"/>
        <conv:BorderHeightConverter x:Key="BorderHeightConverter"/>
        <conv:BlurEffectConverter x:Key="BlurEffectConverter"/>
        <conv:GridHeightConverter x:Key="GridHeightConverter"/>
        <conv:FontWeightConverter x:Key="FontWeightConverter"/>
        <conv:ThicknessConverter x:Key="ThicknessConverter"/>
        <conv:GridWidthConverter x:Key="GridWidthConverter"/>
        <!-- 按钮模板 -->
        <Style x:Key="PreviewButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="{Binding ElementName=FontWeightComboBox, Path=SelectedIndex, Converter={StaticResource FontWeightConverter}}"/>
            <Setter Property="Background" Value="{Binding ElementName=BlankButtonColorButton, Path=Background}"/>
            <Setter Property="BorderBrush" Value="{Binding ElementName=BorderColorButton,Path=Background}"/>
            <Setter Property="Foreground" Value="{Binding ElementName=TextColorButton, Path=Background}"/>
            <Setter Property="FontSize" Value="{Binding ElementName=FontSizeSlider, Path=Value}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{Binding ElementName=BorderWidthSlider, Path=Value, Converter={StaticResource ThicknessConverter}}" Background="{TemplateBinding Background}" CornerRadius="{Binding ElementName=ButtonCornerRadiusSlider, Path=Value}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{Binding ElementName=BlankButtonMouseOverColorButton, Path=Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 标题栏Button -->
        <Style x:Key="Task" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding ElementName=ToolbarColorButton, Path=Background, Converter={StaticResource SmartHoverColorConverter}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="952*"/>
        </Grid.ColumnDefinitions>
        <!-- 基础设置-外观-面板窗口 -->
        <Button x:Name="AppearanceButton"  Content="面板窗口" ToolTip="外观设置" Style="{StaticResource Button3}" Margin="1,14,0,0" Width="82" Grid.Column="1" Height="30" BorderThickness="0,0,0,2"/>
        <Grid x:Name="AppearanceButtonGrid" Margin="10,43,0,0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="186*"/>
                <ColumnDefinition Width="133*"/>
            </Grid.ColumnDefinitions>
            <!-- 设置界面 -->
            <Grid x:Name="SettingGrid" Grid.Column="0" Margin="0,0,0,10">
                <ScrollViewer x:Name="ScrollViewer" VerticalScrollBarVisibility="Hidden" ScrollChanged="ScrollViewer_ScrollChanged">
                    <Grid>
                        <Button x:Name="DefaultAppearanceSettingButton" Content="默认设置" Style="{StaticResource Button3}" Margin="7,10,0,0" Foreground="#FF0087FC" Width="70" BorderThickness="0,0,0,2" Click="DefaultAppearanceSettingButton_Click"/>
                        <Button x:Name="DarkThemeSettingButton" Visibility="Collapsed" Content="深色主题设置" Style="{StaticResource Button3}" Margin="77,10,0,0" Foreground="#FF0087FC" Width="110" BorderThickness="0" Click="DarkThemeSettingButton_Click"/>
                        <Rectangle Fill="#FFD5D5D5" VerticalAlignment="Top" Height="1" Margin="7,40,10,0"/>

                        <!-- 尺寸 -->
                        <GroupBox Header="尺寸" Style="{StaticResource SettingGroupBox}" Margin="15,55,0,0">
                            <Grid>
                                <!-- 按钮大小 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Label Content="按钮大小：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Slider x:Name="ButtonSizeSlider" HorizontalAlignment="Left" Margin="106,6,0,0" VerticalAlignment="Top" Minimum="40" Maximum="100" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="120" ValueChanged="Slider_ValueChanged"/>
                                    <TextBox x:Name="ButtonSizeTextBox" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" Margin="245,2,0,0" TextAlignment="Right" VerticalAlignment="Top" Width="80" Text="{Binding ElementName=ButtonSizeSlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>
                                </Grid>
                                <!-- 按钮间隙 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,33,0,0">
                                    <Label Content="按钮间隙：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Slider x:Name="ButtonGapSlider" HorizontalAlignment="Left" Margin="106,6,0,0" VerticalAlignment="Top" Minimum="0" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="120" ValueChanged="Slider_ValueChanged"/>
                                    <TextBox x:Name="ButtonGapTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="245,2,0,0" TextAlignment="Right" VerticalAlignment="Top" Width="80" Text="{Binding ElementName=ButtonGapSlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>
                                </Grid>
                                <!-- 边框宽度 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,66,0,0">
                                    <Label Content="边框宽度：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Slider x:Name="BorderWidthSlider" HorizontalAlignment="Left" Margin="106,6,0,0" VerticalAlignment="Top" Minimum="0" Maximum="15" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="120" ValueChanged="Slider_ValueChanged"/>
                                    <TextBox x:Name="BorderWidthTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="245,2,0,0" TextAlignment="Right" VerticalAlignment="Top" Width="80" Text="{Binding ElementName=BorderWidthSlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>
                                </Grid>
                                <!-- 按钮圆角 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,99,0,0">
                                    <Label Content="按钮圆角：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Slider x:Name="ButtonCornerRadiusSlider" HorizontalAlignment="Left" Margin="106,6,0,0" VerticalAlignment="Top" Minimum="0" Maximum="40" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="120" ValueChanged="Slider_ValueChanged"/>
                                    <TextBox x:Name="ButtonCornerRadiusTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="245,2,0,0" TextAlignment="Right" VerticalAlignment="Top" Width="80" Text="{Binding ElementName=ButtonCornerRadiusSlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <!-- 颜色 -->
                        <GroupBox Header="颜色" Style="{StaticResource SettingGroupBox}" Margin="15,245,0,0">
                            <Grid>
                                <!-- 背景 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Label Content="背景：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Button x:Name="BackgroundColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="BackgroundColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 边框 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,28,0,0">
                                    <Label Content="边框：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Button x:Name="BorderColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="BorderColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 工具栏 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,56,0,0">
                                    <Label Content="工具栏：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Button x:Name="ToolbarColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="ToolbarColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 工具栏图标 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,84,0,0">
                                    <Label Content="工具栏图标：" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <Button x:Name="ToolbarIconColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="ToolbarIconColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 动作按钮 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,112,0,0">
                                    <Label Content="动作按钮：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Button x:Name="ActionButtonColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="ActionButtonColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 动作按钮鼠标悬浮 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,140,0,0">
                                    <Label Content="动作按钮鼠标悬浮：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Button x:Name="ActionButtonMouseOverColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="ActionButtonMouseOverColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 空白按钮 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,168,0,0">
                                    <Label Content="空白按钮：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Button x:Name="BlankButtonColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="BlankButtonColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 空白按钮鼠标悬浮 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,196,0,0">
                                    <Label Content="空白按钮鼠标悬浮：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Button x:Name="BlankButtonMouseOverColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="BlankButtonMouseOverColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 按钮文字 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,224,0,0">
                                    <Label Content="按钮文字：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Button x:Name="TextColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="TextColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 动作矢量图标色 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,252,0,0" Visibility="Collapsed">
                                    <Label Content="动作矢量图标色：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Button x:Name="ActionIconColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="ActionIconColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 触发键文字颜色 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,280,0,0" Visibility="Collapsed">
                                    <Label Content="触发键文字颜色：" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Button x:Name="TriggerKeyTextColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click" >
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="TriggerKeyTextColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                                <!-- 其他位置矢量图标色 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,308,0,0" Visibility="Collapsed">
                                    <Label Content="其他位置矢量图标色：" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" Width="152"/>
                                    <Button x:Name="OtherIconColorButton" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="152,0,0,0" VerticalAlignment="Top" Width="120" Height="22" Click="ColorButton_Click">
                                        <Rectangle Width="100" Height="16">
                                            <Rectangle.Fill>
                                                <Binding ElementName="OtherIconColorButton" Path="Background"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <!-- 字体 -->
                        <GroupBox Header="字体" Style="{StaticResource SettingGroupBox}" Margin="15,554,0,0">
                            <Grid>
                                <!-- 字体1 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Label Content="字体1：" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <ComboBox x:Name="FontSizeComboBox1" HorizontalAlignment="Left" Margin="124,0,0,0" VerticalAlignment="Center" Width="120" SelectionChanged="ComboBox_SelectionChanged" Height="24">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <!-- 字体2 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,33,0,0">
                                    <Label Content="字体2：" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <ComboBox x:Name="FontSizeComboBox2" HorizontalAlignment="Left" Margin="124,0,0,0" VerticalAlignment="Center" Width="120" SelectionChanged="ComboBox_SelectionChanged" Height="24">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <!-- 字体大小 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,66,0,0">
                                    <Label Content="字体大小：" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <Slider x:Name="FontSizeSlider" HorizontalAlignment="Left" Margin="106,6,0,0" VerticalAlignment="Top" Width="120" Minimum="4" Maximum="24" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                                    <TextBox x:Name="FontSizeTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" TextAlignment="Right" Margin="245,2,0,0" VerticalAlignment="Top" Width="80" Text="{Binding ElementName=FontSizeSlider, Path=Value, Mode=TwoWay, StringFormat='{}{0:F1}'}"/>
                                </Grid>
                                <!-- 字体粗细 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,99,0,0">
                                    <Label Content="字体粗细：" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <ComboBox x:Name="FontWeightComboBox" HorizontalAlignment="Left" Margin="124,0,0,0" VerticalAlignment="Center" Width="120" SelectionChanged="ComboBox_SelectionChanged" Height="24">
                                        <ComboBoxItem Content="Thin" FontWeight="Thin"/>
                                        <ComboBoxItem Content="ExtraLight" FontWeight="ExtraLight"/>
                                        <ComboBoxItem Content="UltraLight" FontWeight="UltraLight"/>
                                        <ComboBoxItem Content="Light" FontWeight="Light"/>
                                        <ComboBoxItem Content="Normal" FontWeight="Normal"/>
                                        <ComboBoxItem Content="Regular" FontWeight="Regular"/>
                                        <ComboBoxItem Content="Medium" FontWeight="Medium"/>
                                        <ComboBoxItem Content="DemiBold" FontWeight="DemiBold"/>
                                        <ComboBoxItem Content="SemiBold" FontWeight="SemiBold"/>
                                        <ComboBoxItem Content="Bold" FontWeight="Bold"/>
                                        <ComboBoxItem Content="ExtraBold" FontWeight="ExtraBold"/>
                                        <ComboBoxItem Content="UltraBold" FontWeight="UltraBold"/>
                                        <ComboBoxItem Content="Black" FontWeight="Black"/>
                                        <ComboBoxItem Content="Heavy" FontWeight="Heavy"/>
                                        <ComboBoxItem Content="ExtraBlack" FontWeight="ExtraBlack"/>
                                        <ComboBoxItem Content="UltraBlack" FontWeight="UltraBlack"/>
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <!-- 背景图片 -->
                        <GroupBox Header="背景图片" Style="{StaticResource SettingGroupBox}" Margin="15,739,0,0">
                            <Grid>
                                <!-- 路径 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Label Content="路径：" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="BackgroundImagePathTextBox" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" TextAlignment="Right" VerticalAlignment="Center" Width="200" Text="{Binding BackgroundImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="BackgroundImagePathTextBox_TextChanged" Margin="57,0,0,0"/>
                                    <Button x:Name="BackgroundImagePathButton" ToolTip="左键添加背景图片，右键清空当前图片" Content="选择..." Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="272,0,0,0" Width="53" Click="BackgroundImagePathButton_Click" MouseRightButtonDown="BackgroundImagePathButton_MouseRightButtonDown"/>
                                    <Popup x:Name="BackgroundImagePathPopup" PopupAnimation="Fade" Width="150" Height="62" PlacementTarget="{Binding ElementName=BackgroundImagePathButton}" AllowsTransparency="True" StaysOpen="False">
                                        <Grid>
                                            <Border Background="White" BorderThickness="0" CornerRadius="3" Margin="3">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="5" RenderingBias="Quality" ShadowDepth="1"/>
                                                </Border.Effect>
                                            </Border>
                                            <Border Background="White" BorderThickness="0" CornerRadius="3" Margin="3">
                                                <StackPanel Background="{x:Null}">
                                                    <Button x:Name="SelectBackgroundImageButton" Content="选择图片" Style="{StaticResource MenuButton}" Margin="0,3,0,0" Click="SelectBackgroundImageButton_Click"/>
                                                    <Button x:Name="InsertClipboardTextButton" Content="插入剪切贴板文本" Style="{StaticResource MenuButton}" Margin="0,0,0,3" Click="InsertClipboardTextButton_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                </Grid>
                                <!-- 不透明度 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,33,0,0">
                                    <Label Content="不透明度：" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <Slider x:Name="BackgroundImageOpacitySlider" HorizontalAlignment="Left" Margin="106,6,0,0" VerticalAlignment="Top" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Width="120" Value="{Binding ElementName=PreviewBackgroundImage, Path=Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="Slider_ValueChanged"/>
                                    <TextBox x:Name="BackgroundImageOpacityTextBox" Style="{StaticResource ResourceKey=RoundedTextBox}" HorizontalAlignment="Left" Margin="245,2,0,0" TextAlignment="Right" VerticalAlignment="Top" Width="80" Text="{Binding ElementName=PreviewBackgroundImage, Path=Opacity, Mode=TwoWay, StringFormat='{}{0:F2}'}"/>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <!-- 模糊与圆角 -->
                        <GroupBox Header="模糊与圆角" Style="{StaticResource SettingGroupBox}" Margin="15,851,0,0">
                            <Grid>
                                <!-- 模糊模式 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Label Content="模糊模式：" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <!-- 选项说明：
                                         0: 无 —— 不显示毛玻璃和阴影，界面为普通不透明背景。
                                         1: 毛玻璃 —— 显示毛玻璃（BlurEffect），并带有阴影，类似Win11毛玻璃效果。
                                         2: 无（去除窗口阴影）—— 不显示毛玻璃，且去除窗口阴影，界面为纯色无阴影。
                                         3: 毛玻璃（去除窗口阴影）—— 显示毛玻璃，但不显示阴影，界面为半透明毛玻璃无阴影。
                                     -->
                                    <ComboBox x:Name="BlurComboBox" HorizontalAlignment="Left" Margin="124,0,0,0" VerticalAlignment="Center" Width="120" Height="24" SelectionChanged="ComboBox_SelectionChanged">
                                        <ComboBoxItem Content="无"/>
                                        <ComboBoxItem Content="毛玻璃"/>
                                        <ComboBoxItem Content="无（去除窗口阴影）"/>
                                        <ComboBoxItem Content="毛玻璃（去除窗口阴影）"/>
                                    </ComboBox>
                                </Grid>
                                <!-- Win11圆角模式 -->
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,33,0,0">
                                    <Label Content="Win11圆角模式：" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                    <!-- 选项说明：
                                         0: 默认 —— 使用默认圆角（5px），界面有适度圆角。
                                         1: 无 —— 无圆角，所有边为直角。
                                         2: 圆角 —— 明显的圆角（5px），与默认相同。
                                         3: 小圆角 —— 圆角半径较小（3px），界面略带圆角。
                                     -->
                                    <ComboBox x:Name="Win11CornerRadiusComboBox" HorizontalAlignment="Left" Margin="124,0,0,0" VerticalAlignment="Top" Width="120" Height="24" SelectionChanged="ComboBox_SelectionChanged">
                                        <ComboBoxItem Content="默认"/>
                                        <ComboBoxItem Content="无"/>
                                        <ComboBoxItem Content="圆角"/>
                                        <ComboBoxItem Content="小圆角"/>
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <!-- 选项 -->
                        <GroupBox Header="选项" Style="{StaticResource SettingGroupBox}" Margin="15,958,0,0">
                            <Grid>
                                <CheckBox x:Name="AutoHideTitleBarCheckBox" Content="自动缩小动作名称文字" ToolTip="按钮文字过长时自动缩小以显示全部" HorizontalAlignment="Left" VerticalAlignment="Top" Click="CheckBox_Click" FontSize="14" Margin="4,0,0,0"/>
                                <CheckBox x:Name="ShowActionButtonMouseOverCheckBox" Content="鼠标悬浮在动作按钮上时，放大显示按钮" ToolTip="鼠标移动到动作上时自动放大按钮" HorizontalAlignment="Left" Margin="4,23,0,0" VerticalAlignment="Top" Click="CheckBox_Click" FontSize="14"/>
                                <CheckBox x:Name="HideActionNameAfterIconCheckBox" Content="设置动作图标后隐藏动作名称" ToolTip="如果动作设置了图标，则只显示图标不显示名称" HorizontalAlignment="Left" Margin="4,46,0,0" VerticalAlignment="Top" Click="CheckBox_Click" FontSize="14"/>
                                <CheckBox x:Name="ShowActionIconShadowCheckBox" Content="动作图标显示阴影" ToolTip="动作图标显示阴影效果" HorizontalAlignment="Left" Margin="4,69,0,0" VerticalAlignment="Top" Click="CheckBox_Click" FontSize="14"/>
                            </Grid>
                        </GroupBox>

                        <!-- 用于扩展可见范围，无功能 -->
                        <Label Margin="10,1134,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    </Grid>
                </ScrollViewer>
                <ScrollBar x:Name="AppearanceScrollBar" HorizontalAlignment="Right" Width="18" ValueChanged="AppearanceScrollBar_ValueChanged" Margin="0,20,0,0">
                    <ScrollBar.Style>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=SettingGrid}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollBar.Style>
                </ScrollBar>
            </Grid>

            <!-- 其他 -->
            <Button x:Name="ResetAppearanceButton" Grid.Column="1" Content="重置" Style="{StaticResource WhiteButton}" ToolTip="还原到配置之前的设置" HorizontalAlignment="Left" Margin="46,49,0,0" VerticalAlignment="Top" Width="122" Click="ResetAppearanceButton_Click"/>
            <Button x:Name="PresetStyleButton" Grid.Column="1" Content="预置风格..." Foreground="#FF00B3FF" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="46,20,0,0" VerticalAlignment="Top" Width="122" Click="PresetStyleButton_Click"/>
            <Popup x:Name="PresetStylePopup" PopupAnimation="Fade" Width="154" Height="140" PlacementTarget="{Binding ElementName=PresetStyleButton}" AllowsTransparency="True" StaysOpen="False">
                <Grid>
                    <!-- 阴影 -->
                    <Rectangle Fill="White" Margin="3,5">
                        <Rectangle.Effect>
                            <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="8" RenderingBias="Quality" ShadowDepth="1"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <Border CornerRadius="5" Padding="0,5" BorderThickness="0" Background="White" Margin="3">
                        <StackPanel Background="{x:Null}">
                            <Button Content="原始" Style="{StaticResource MenuButton}" Click="PresetStyleItem_Click" Tag="Original"/>
                            <Button Content="小白" Style="{StaticResource MenuButton}" Click="PresetStyleItem_Click" Tag="Simple"/>
                            <Button Content="半透" Style="{StaticResource MenuButton}" Click="PresetStyleItem_Click" Tag="Translucent"/>
                            <Button Content="深色" Style="{StaticResource MenuButton}" Click="PresetStyleItem_Click" Tag="Dark"/>
                            <Button Content="深色半透" Style="{StaticResource MenuButton}" Click="PresetStyleItem_Click" Tag="DarkTranslucent"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Popup>
            <Button x:Name="ShareSaveAppearanceButton" Grid.Column="1" Content="分享或保存外观" ToolTip="分享或保存当前的外观" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="46,78,0,0" VerticalAlignment="Top" Width="122" Click="ShareSaveAppearanceButton_Click"/>
            <Button x:Name="SharedSavedAppearanceButton" Grid.Column="1" Content="已分享或保存的外观" ToolTip="查看已分享或保存的外观" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="46,107,0,0" VerticalAlignment="Top" Width="122" Click="SharedSavedAppearanceButton_Click"/>
            <Button x:Name="ExportAppearanceButton" Grid.Column="1" Content="已保存的背景" ToolTip="查看图片" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="46,136,0,0" VerticalAlignment="Top" Width="122" Click="ExportAppearanceButton_Click"/>
            <Button x:Name="ImportAppearanceButton" Content="导入外观" ToolTip="导入外观" Click="ImportAppearanceButton_Click" Grid.Column="1" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="46,165,0,0" VerticalAlignment="Top" Width="122"/>
            <CheckBox x:Name="EnablePreviewCheckBox" Grid.Column="1" Content="开启预览" ToolTip="查看应用设置后的功能面板外观" HorizontalAlignment="Left" Margin="173,23,0,0" VerticalAlignment="Top" FontSize="14" Click="EnablePreviewCheckBox_Click" Panel.ZIndex="1"/>
            <TextBlock Grid.Column="1" Text="只加载全局动作，通用动作用于做空白对照" HorizontalAlignment="Left" Margin="173,54,0,0" VerticalAlignment="Top" FontSize="11" Foreground="#FFB4B4B4" TextWrapping="Wrap" MaxWidth="210"/>

            <!-- 预览面板 -->
            <Grid Margin="46,78,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="1">
                <!-- 预览面板阴影 -->
                <Border x:Name="ShadowBorder" Margin="0.6" Background="#FFF3F3F3" Visibility="{Binding Visibility, ElementName=ViewPreviewBorder}" CornerRadius="{Binding PreviewCornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <!-- BlurComboBox.SelectedIndex = 0: 无 效果：无毛玻璃，有阴影，界面为普通不透明背景带阴影。 -->
                                <DataTrigger Binding="{Binding ElementName=BlurComboBox, Path=SelectedIndex}" Value="0">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <!-- BlurComboBox.SelectedIndex = 1: 毛玻璃 效果：有毛玻璃，有阴影，界面为半透明毛玻璃带阴影。 -->
                                <DataTrigger Binding="{Binding ElementName=BlurComboBox, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                                <!-- BlurComboBox.SelectedIndex = 2: 无（去除窗口阴影） 效果：无毛玻璃，无阴影，界面为纯色无阴影。 -->
                                <DataTrigger Binding="{Binding ElementName=BlurComboBox, Path=SelectedIndex}" Value="2">
                                    <Setter Property="Effect" Value="{x:Null}"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <!-- BlurComboBox.SelectedIndex = 3: 毛玻璃（去除窗口阴影） 效果：有毛玻璃，无阴影，界面为半透明毛玻璃无阴影。 -->
                                <DataTrigger Binding="{Binding ElementName=BlurComboBox, Path=SelectedIndex}" Value="3">
                                    <Setter Property="Effect" Value="{x:Null}"/>
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <!-- 预览面板模糊 -->
                <Border x:Name="BlurBorder" Background="Transparent" Visibility="{Binding Visibility, ElementName=ViewPreviewBorder}" CornerRadius="{Binding PreviewCornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="{Binding ActualWidth, ElementName=ViewPreviewBorder}" Height="{Binding ActualHeight, ElementName=ViewPreviewBorder}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <!-- BlurComboBox.SelectedIndex = 1: 毛玻璃 效果：显示毛玻璃（BlurEffect）。 -->
                                <DataTrigger Binding="{Binding ElementName=BlurComboBox, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <BlurEffect Radius="15"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!-- BlurComboBox.SelectedIndex = 3: 毛玻璃（去除窗口阴影） 效果：显示毛玻璃（BlurEffect）。 -->
                                <DataTrigger Binding="{Binding ElementName=BlurComboBox, Path=SelectedIndex}" Value="3">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <BlurEffect Radius="15"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <!-- 设置面板预览 -->
                <Border x:Name="ViewPreviewBorder" Background="{Binding ElementName=BackgroundColorButton, Path=Background}" CornerRadius="{Binding PreviewCornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}" helpers:ClipHelper.ClipToBounds="True">
                    <Border.Height>
                        <MultiBinding Converter="{StaticResource BorderHeightConverter}">
                            <Binding ElementName="ButtonSizeSlider" Path="Value"/>
                            <Binding ElementName="ButtonGapSlider" Path="Value"/>
                        </MultiBinding>
                    </Border.Height>
                    <Border.Width>
                        <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                            <Binding ElementName="ButtonSizeSlider" Path="Value"/>
                            <Binding ElementName="ButtonGapSlider" Path="Value"/>
                        </MultiBinding>
                    </Border.Width>
                    <Grid x:Name="MainGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="{Binding ElementName=GlobalGrid, Path=ActualHeight}"/>
                            <RowDefinition Height="25.5"/>
                            <RowDefinition Height="{Binding ElementName=CommonGrid, Path=ActualHeight}"/>
                        </Grid.RowDefinitions>
                        <!-- 背景图片 -->
                        <Image x:Name="PreviewBackgroundImage" Stretch="Fill" Opacity="{Binding Value, ElementName=BackgroundImageOpacitySlider, Mode=OneWay}" Width="{Binding ActualWidth, ElementName=ViewPreviewBorder}" Height="{Binding ActualHeight, ElementName=ViewPreviewBorder}" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="0" Grid.RowSpan="4"/>
                        <!-- 标题栏 -->
                        <Grid x:Name="TitleBarGrid" Background="{Binding ElementName=ToolbarColorButton, Path=Background}" Grid.RowSpan="1">
                            <Label Content="Quicker" Margin="2" Width="58" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{Binding ElementName=ToolbarIconColorButton, Path=Background}" FontSize="13"/>
                            <Button Style="{StaticResource Task}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="58,0,0,0">
                                <Rectangle Width="16" Height="16" Fill="{Binding ElementName=ToolbarIconColorButton, Path=Background}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/SettingImage2.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>
                            <Button x:Name="ActionPageManager" Style="{StaticResource Task}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="82,0,0,0">
                                <Grid>
                                    <Rectangle Width="16" Height="16" Fill="{Binding ElementName=ToolbarIconColorButton, Path=Background}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="/Resources/Images/MoreSelection.png"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Border x:Name="HasNewVersionTip" CornerRadius="4" Background="#11AD45" Margin="12,12,0,0"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource Task}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,0">
                                <Rectangle Width="20" Height="20" Fill="{Binding ElementName=ToolbarIconColorButton, Path=Background}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/UnpinFromDesktop.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>
                            <Button Style="{StaticResource Task}" HorizontalAlignment="Right" Margin="0,0,3,0">
                                <Rectangle Width="20" Height="20" Fill="{Binding ElementName=ToolbarIconColorButton, Path=Background}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/CloseWindow.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>
                        </Grid>
                        <!-- 全局动作 -->
                        <Grid x:Name="GlobalGrid" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Row="1">
                            <Grid.Height>
                                <MultiBinding Converter="{StaticResource GridHeightConverter}" ConverterParameter="3">
                                    <Binding ElementName="ButtonSizeSlider" Path="Value"/>
                                    <Binding ElementName="ButtonGapSlider" Path="Value"/>
                                </MultiBinding>
                            </Grid.Height>
                            <Grid.Width>
                                <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                                    <Binding ElementName="ButtonSizeSlider" Path="Value"/>
                                    <Binding ElementName="ButtonGapSlider" Path="Value"/>
                                </MultiBinding>
                            </Grid.Width>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 第一行 -->
                            <Button x:Name="_global11" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="0" Grid.Column="0" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <Button x:Name="_global12" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="0" Grid.Column="2" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <Button x:Name="_global13" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="0" Grid.Column="4" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <Button x:Name="_global14" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="0" Grid.Column="6" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <!-- 第二行 -->
                            <Button x:Name="_global21" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="2" Grid.Column="0" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <Button x:Name="_global22" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="2" Grid.Column="2" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <Button x:Name="_global23" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="2" Grid.Column="4" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <Button x:Name="_global24" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="2" Grid.Column="6" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <!-- 第三行 -->
                            <Button x:Name="_global31" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="4" Grid.Column="0" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <Button x:Name="_global32" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="4" Grid.Column="2" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <Button x:Name="_global33" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="4" Grid.Column="4" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                            <Button x:Name="_global34" Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="4" Grid.Column="6" MouseEnter="PreviewButton_MouseEnter" MouseLeave="PreviewButton_MouseLeave"/>
                        </Grid>
                        <!-- 功能栏 -->
                        <Grid x:Name="FunctionBarGrid" VerticalAlignment="Center" Height="25" Background="{Binding ElementName=ToolbarColorButton, Path=Background}" Grid.Row="2">
                            <TextBlock x:Name="CommonTextBlock" Text="默认" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding ElementName=ToolbarIconColorButton, Path=Background}" TextAlignment="Center" Margin="10,0"/>
                            <Button IsEnabled="False" HorizontalAlignment="Right" Margin="0,0,58,0" Style="{StaticResource Task}">
                                <Rectangle Width="14" Height="14" Fill="{Binding ElementName=ToolbarIconColorButton, Path=Background}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>
                            <Button Style="{StaticResource Task}" HorizontalAlignment="Right" Margin="0,0,34,0">
                                <Rectangle Width="14" Height="14" Fill="{Binding ElementName=ToolbarIconColorButton, Path=Background}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Resources/Images/UnLocked.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>
                        </Grid>
                        <!-- 通用动作 -->
                        <Grid x:Name="CommonGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="3">
                            <Grid.Height>
                                <MultiBinding Converter="{StaticResource GridHeightConverter}" ConverterParameter="4">
                                    <Binding ElementName="ButtonSizeSlider" Path="Value"/>
                                    <Binding ElementName="ButtonGapSlider" Path="Value"/>
                                </MultiBinding>
                            </Grid.Height>
                            <Grid.Width>
                                <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                                    <Binding ElementName="ButtonSizeSlider" Path="Value"/>
                                    <Binding ElementName="ButtonGapSlider" Path="Value"/>
                                </MultiBinding>
                            </Grid.Width>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="{Binding ElementName=ButtonGapSlider, Path=Value}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 第一行 -->
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="0" Grid.Column="0"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="0" Grid.Column="2"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="0" Grid.Column="4"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="0" Grid.Column="6"/>
                            <!-- 第二行 -->
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="2" Grid.Column="0"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="2" Grid.Column="2"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="2" Grid.Column="4"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="2" Grid.Column="6"/>
                            <!-- 第三行 -->
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="4" Grid.Column="0"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="4" Grid.Column="2"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="4" Grid.Column="4"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="4" Grid.Column="6"/>
                            <!-- 第四行 -->
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="6" Grid.Column="0"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="6" Grid.Column="2"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="6" Grid.Column="4"/>
                            <Button Style="{StaticResource PreviewButtonStyle}" Width="{Binding ElementName=ButtonSizeSlider, Path=Value}" Height="{Binding ElementName=ButtonSizeSlider, Path=Value}" Grid.Row="6" Grid.Column="6"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 添加颜色选择器Popup -->
        <Popup x:Name="ColorPickerPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=BackgroundColorButton}" AllowsTransparency="True" Closed="ColorPickerPopup_Closed">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                <setting:ColorPicker x:Name="PopupColorPicker" Width="245" Height="280" SelectedColorChanged="PopupColorPicker_SelectedColorChanged"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>