<UserControl
    x:Class="Quicker.UserControls.SettingWindow.BasicSettings.OpenMainWindowControl"
    xmlns:local="clr-namespace:Quicker.UserControls.SettingWindow.BasicSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"

    d:DesignHeight="870"
    d:DesignWidth="982"

    Unloaded="OpenMainWindowGrid_Unloaded"
>
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="953*"/>
        </Grid.ColumnDefinitions>
        <!-- 基础设置-弹出面板-弹出面板 -->
        <Button x:Name="OpenMainWindowButton" Content="弹出面板" ToolTip="面板窗口的触发方式" Style="{StaticResource Button3}" Margin="1,14,0,0" Width="74" Click="OpenMainWindowButton_Click" Grid.Column="1" BorderThickness="0,0,0,2"/>
        <Grid x:Name="OpenMainWindowButtonGrid" Margin="10,43,0,0" Visibility="Visible" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="186*"/>
                <ColumnDefinition Width="133*"/>
            </Grid.ColumnDefinitions>
            <!-- 鼠标方式 -->
            <GroupBox Header="鼠标方式" Style="{StaticResource SettingGroupBox}" Margin="10,33,0,0">
                <Grid>
                    <CheckBox x:Name="OpenMainWindowByMiddleMouseClickCheckBox" Content="按下中键" ToolTip="按下鼠标中键" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0"/>
                    <CheckBox x:Name="OpenMainWindowByX1MouseClickCheckBox" Content="按下X1键" ToolTip="需鼠标支持，通常为侧键" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,18,0,0"/>
                    <CheckBox x:Name="OpenMainWindowByX2MouseClickCheckBox" Content="按下X2键" ToolTip="需鼠标支持，通常为侧键" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,36,0,0"/>
                    <CheckBox x:Name="OpenMainWindowByCtrl_MiddleMouseClickCheckBox" Content="Ctrl+中键单击" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,54,0,0"/>
                    <CheckBox x:Name="OpenMainWindowByCtrl_RightMouseClickCheckBox" Content="Ctrl+右键单击" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,72,0,0"/>
                    <CheckBox x:Name="OpenMainWindowByMiddleMouseClickLongerCheckBox" Content="长按中键" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,90,0,0"/>
                    <CheckBox x:Name="OpenMainWindowByRightMouseClickLongerCheckBox" Content="长按右键" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,108,0,0"/>
                    <CheckBox x:Name="OpenMainWindowByRightMouseClick_MoveCheckBox" Content="按右键移动" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,126,0,0"/>
                </Grid>
            </GroupBox>
            <!-- 键盘方式 -->
            <GroupBox Header="键盘方式" Style="{StaticResource SettingGroupBox}" Margin="10,235,0,0">
                <Grid>
                    <CheckBox x:Name="OpenMainWindowByCtrlCheckBox" Content="单击Ctrl键" Margin="10,10,0,0" Click="CheckBox_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <!--<Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,33,0,0">
                        <TextBox x:Name="DIY_ShortcutKeys" ToolTip="请按键" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="251" KeyDown="DIY_ShortcutKeys_KeyDown" PreviewTextInput="DIY_ShortcutKeys_PreviewTextInput" PreviewKeyUp="DIY_ShortcutKeys_PreviewKeyUp" TextAlignment="Center" GotFocus="DIY_ShortcutKeys_GotFocus"/>
                        <Button HorizontalAlignment="Left" VerticalAlignment="Center" Width="21" Height="17" Click="ClearDIY_ShortcutKeys" Margin="256,0,0,0"/>
                    </Grid>-->
                    <GroupBox Header="键盘弹出选项" Margin="10,85,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid>
                            <ComboBox x:Name="WindowStartupLocationComboBox" HorizontalAlignment="Left" Margin="95,14,0,0" VerticalAlignment="Top" Width="120" IsReadOnly="True" SelectionChanged="ComboBox_SelectionChanged">
                                <ComboBoxItem>
                                    <TextBlock Text="系统默认" Margin="5,0"/>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <TextBlock Text="跟随鼠标" Margin="5,0"/>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <TextBlock Text="屏幕中心" Margin="5,0"/>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <TextBlock Text="当前窗口中心" Margin="5,0"/>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <TextBlock Text="上次弹出位置" Margin="5,0"/>
                                </ComboBoxItem>
                            </ComboBox>
                            <Label Content="弹出位置：" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </GroupBox>
            <!-- 按键测试区 -->
            <Button x:Name="TestButton" Content="按键测试区" ToolTip="在此处点击鼠标按键以显示按键名称。" Style="{StaticResource WhiteButton}" HorizontalAlignment="Stretch" Margin="0,33,17,0" VerticalAlignment="Top" Width="NaN" Height="83" PreviewMouseDown="TestMouseKey" FontSize="16" Grid.Column="1"/>
        </Grid>
    </Grid>
</UserControl>
