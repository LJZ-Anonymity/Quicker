<Window
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:setting="clr-namespace:Quicker.UserControls.SettingWindow"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Quicker.Windows.ToolWindows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.Windows.ToolWindows.ImageCropWindow"
    mc:Ignorable="d"

    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    Title="裁剪图片"
    Height="520"
    Width="800"

    KeyDown="ImageCropWindow_KeyDown"
    Loaded="ImageCropWindow_Loaded"
    Closed="ImageCropWindow_Closed"
>
    <Canvas>
        <Grid x:Name="ImageGrid" Canvas.Left="10" Canvas.Top="10" Width="600" Height="450" Background="{Binding Tag, ElementName=BackgroundColorButton}">
            <Image x:Name="CropImage" Stretch="Uniform"/>
            <Rectangle x:Name="MaskRect" Fill="Black" Opacity="0.5" Height="{Binding ActualHeight, ElementName=ImageGrid}" Width="{Binding ActualWidth, ElementName=ImageGrid}"/>
        </Grid>
        <Border x:Name="CropBorder" Background="Transparent" BorderBrush="{Binding Tag, ElementName=BorderColorButton}" BorderThickness="2" Width="{Binding BorderWidth}" Height="{Binding BorderHeight}" MaxHeight="{Binding ActualHeight, ElementName=ImageGrid}" CornerRadius="{Binding BorderCornerRadius}" MouseLeftButtonDown="CropBorder_MouseLeftButtonDown" MouseMove="CropBorder_MouseMove" MouseLeftButtonUp="CropBorder_MouseLeftButtonUp" Cursor="SizeAll" Canvas.Left="15" Canvas.Top="15">
            <!-- 调整锚点 -->
            <Grid>
                <!-- 左上角 -->
                <Rectangle x:Name="ResizeHandleTopLeft" Width="8" Height="8" Fill="{Binding Tag, ElementName=HandleColorButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Cursor="SizeNWSE" Tag="TopLeft"/>
                <!-- 右上角 -->
                <Rectangle x:Name="ResizeHandleTopRight" Width="8" Height="8" Fill="{Binding Tag, ElementName=HandleColorButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Cursor="SizeNESW" Tag="TopRight"/>
                <!-- 左下角 -->
                <Rectangle x:Name="ResizeHandleBottomLeft" Width="8" Height="8" Fill="{Binding Tag, ElementName=HandleColorButton}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Cursor="SizeNESW" Tag="BottomLeft"/>
                <!-- 右下角 -->
                <Rectangle x:Name="ResizeHandleBottomRight" Width="8" Height="8" Fill="{Binding Tag, ElementName=HandleColorButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Cursor="SizeNWSE" Tag="BottomRight"/>
                <!-- 上边中点 -->
                <Rectangle x:Name="ResizeHandleTop" Width="8" Height="8" Fill="{Binding Tag, ElementName=HandleColorButton}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Cursor="SizeNS" Tag="Top"/>
                <!-- 下边中点 -->
                <Rectangle x:Name="ResizeHandleBottom" Width="8" Height="8" Fill="{Binding Tag, ElementName=HandleColorButton}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Cursor="SizeNS" Tag="Bottom"/>
                <!-- 左边中点 -->
                <Rectangle x:Name="ResizeHandleLeft" Width="8" Height="8" Fill="{Binding Tag, ElementName=HandleColorButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Cursor="SizeWE" Tag="Left"/>
                <!-- 右边中点 -->
                <Rectangle x:Name="ResizeHandleRight" Width="8" Height="8" Fill="{Binding Tag, ElementName=HandleColorButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Cursor="SizeWE" Tag="Right"/>
            </Grid>
        </Border>
        <!-- 按钮 -->
        <CheckBox x:Name="UseOriginalImageCheckBox" Content="直接使用原图" Canvas.Left="663" Canvas.Top="386" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button Content="顺时针旋转90°" Canvas.Left="655" Canvas.Top="97" Style="{StaticResource WhiteButton}" Width="108" VerticalAlignment="Top" Click="RotateRightButton_Click"/>
        <Button Content="逆时针旋转90°" Canvas.Left="655" Canvas.Top="68" Style="{StaticResource WhiteButton}" Width="108" Click="RotateLeftButton_Click" VerticalAlignment="Top"/>
        <Button Content="垂直翻转" Canvas.Left="655" Canvas.Top="166" Style="{StaticResource WhiteButton}" Width="108" VerticalAlignment="Top" Click="FlipVerticalButton_Click"/>
        <Button Content="水平翻转" Canvas.Left="655" Canvas.Top="137" Style="{StaticResource WhiteButton}" Width="108" VerticalAlignment="Top" Click="FlipHorizontalButton_Click"/>
        <Button x:Name="SaveButton" Click="SaveButton_Click" Canvas.Left="655" Canvas.Top="407" Width="108" VerticalAlignment="Top">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource BlueButton}">
                    <Setter Property="Content" Value="裁剪并保存"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=UseOriginalImageCheckBox}" Value="True">
                            <Setter Property="Content" Value="保存原图"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button x:Name="CancelButton" Click="CancelButton_Click" Content="取消" Style="{StaticResource WhiteButton}" Canvas.Left="655" Canvas.Top="436" VerticalAlignment="Top" Width="108"/>
        <Button Content="更改图片" Style="{StaticResource WhiteButton}" Canvas.Left="655" Canvas.Top="10" HorizontalAlignment="Center" VerticalAlignment="Top" Width="108" Click="ChangeImageButton_Click"/>
        <!-- 颜色选择器 -->
        <Button x:Name="BackgroundColorButton" Canvas.Left="655" Canvas.Top="240" Width="108" Style="{StaticResource WhiteButton}" Click="ColorButton_Click">
            <Button.Tag>
                <SolidColorBrush Color="Black"/>
            </Button.Tag>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,6,0"/>
                <TextBlock Text="更改背景色" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button x:Name="BorderColorButton" Canvas.Left="655" Canvas.Top="270" Width="108" Style="{StaticResource WhiteButton}" Click="ColorButton_Click">
            <Button.Tag>
                <SolidColorBrush Color="White"/>
            </Button.Tag>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,6,0"/>
                <TextBlock Text="更改边框色" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button x:Name="HandleColorButton" Canvas.Left="655" Canvas.Top="300" Width="108" Style="{StaticResource WhiteButton}" Click="ColorButton_Click">
            <Button.Tag>
                <SolidColorBrush Color="White"/>
            </Button.Tag>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,6,0"/>
                <TextBlock Text="更改锚点色" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Slider Canvas.Left="651" Canvas.Top="330" HorizontalAlignment="Left" VerticalAlignment="Top" Width="108" Visibility="Collapsed"/>
        <Popup x:Name="ColorPickerPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="3">
                <setting:ColorPicker x:Name="PopupColorPicker" Width="245" Height="280" SelectedColorChanged="PopupColorPicker_SelectedColorChanged"/>
            </Border>
        </Popup>
    </Canvas>
</Window>