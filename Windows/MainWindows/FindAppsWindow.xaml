<Window
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Quicker.Windows.MainWindows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quicker.Windows.MainWindows.FindAppsWindow"
    xmlns:conv="clr-namespace:Quicker.Converters"
    xmlns:helpers="clr-namespace:Quicker.Helpers"
    mc:Ignorable="d"

    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Title="选择应用程序"
    Height="450"
    Width="500"

    ContentRendered="LoadApplications"
>
    <Window.Resources>
        <!-- 定义 GridViewColumnHeader 样式，使所有标题左对齐 -->
        <Style x:Key="LeftAlignedHeader" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <conv:HighlightTextConverter x:Key="HighlightTextConverter"/>
    </Window.Resources>

    <Grid>
        <TextBox x:Name="SearchTextBox" Style="{StaticResource RoundedTextBox}" TextWrapping="Wrap" Width="150" Height="27" Margin="13,17,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="13" TextChanged="SearchTextBox_TextChanged"/>
        <Button Style="{StaticResource WhiteButton}" Content="搜索" Margin="168,17,0,0" Click="SearchButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Width="48" Height="27"/>
        <Button Style="{StaticResource WhiteButton}" Content="刷新" Margin="242,17,0,0" Click="RefreshButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Height="27"/>
        <Button Style="{StaticResource WhiteButton}" Content="浏览..." Margin="305,17,0,0" Click="BrowseButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Width="55" Height="27"/>
        <Button x:Name="SelectWindowButton" Style="{StaticResource WhiteButton}" Margin="382.5,17,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="86" Height="27" Click="SelectWindowButton_Click">
            <Grid Width="76">
                <TextBlock Text="选择窗口" Margin="23,0,0,0"/>
                <Image Source="/Resources/Images/Target.png" Margin="5,0,56,0" Width="15" Height="15"/>
            </Grid>
        </Button>
        <Grid  Margin="13,49,11,42" MouseEnter="ShowScrollBar" MouseLeave="HideScrollBar">
            <ListView x:Name="ApplicationsListView" SelectionMode="Single" BorderBrush="#FFD9D9D9" SelectionChanged="ApplicationsListView_SelectionChanged" Background="{x:Null}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" Foreground="Black" ScrollViewer.CanContentScroll="False" MouseDoubleClick="SaveApplication" PreviewMouseRightButtonDown="CopyLocation" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,0,4,4" ScrollViewer.ScrollChanged="ListViewScrollViewer_ScrollChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF2F2F2" />
                                <Setter Property="BorderBrush" Value="#FFF2F2F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFDDDDDD" />
                                <Setter Property="BorderBrush" Value="#FFDDDDDD" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="250" HeaderContainerStyle="{StaticResource LeftAlignedHeader}" Header="应用名称">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"  ToolTip="右键项目复制所在文件夹地址">
                                        <Image Width="16" Height="16" Source="{Binding Icon, IsAsync=True}"/>
                                        <!-- 应用名称 -->
                                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" helpers:TextBlockHelper.Highlight="{Binding NameAndSearchText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="350" HeaderContainerStyle="{StaticResource LeftAlignedHeader}" Header="地址">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock ToolTip="右键项目复制所在文件夹地址" helpers:TextBlockHelper.Highlight="{Binding TagAndSearchText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <!-- 垂直滚动条 -->
            <ScrollBar Name="VerticalScrollBar" Orientation="Vertical" Visibility="Visible" HorizontalAlignment="Right" Margin="0,22,0,5" ValueChanged="VerticalScrollBar_ValueChanged"/>
            <!-- 水平滚动条 -->
            <ScrollBar Name="HorizontalScrollBar" Orientation="Horizontal" Visibility="Visible" VerticalAlignment="Bottom" Margin="1,0,12,1" ValueChanged="HorizontalScrollBar_ValueChanged"/>
        </Grid>
        <Button x:Name="SaveButton" Content="保存(S)" Style="{StaticResource BlueButton}" HorizontalAlignment="Right" Margin="0,0,70,14" VerticalAlignment="Bottom" Width="60" IsEnabled="False" Height="28" Click="SaveApp"/>
        <Button Content="取消" Style="{StaticResource WhiteButton}" HorizontalAlignment="Right" Margin="0,0,15,14" VerticalAlignment="Bottom" Width="45" Click="CloseThisWindow" Height="27.5"/>
    </Grid>
</Window>