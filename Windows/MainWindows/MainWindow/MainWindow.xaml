<Window
    xmlns:mainwindow="clr-namespace:Quicker.Windows.MainWindows.MainWindow"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=mainwindow:MainWindowViewModel}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    x:Class="Quicker.Windows.MainWindows.MainWindow.MainWindow"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:styles="clr-namespace:Quicker.Resources.Styles"
    xmlns:helpers="clr-namespace:Quicker.Helpers"
    xmlns:conv="clr-namespace:Quicker.Converters"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    mc:Ignorable="d"

    AllowsTransparency="True"
    ShowInTaskbar="False"
    Background="{x:Null}"
    ResizeMode="NoResize"
    WindowStyle="None"
    Topmost="True"
    Height="850"
    Width="450"

    IsVisibleChanged="MainWindow_IsVisibleChanged"
    MouseLeftButtonDown="MoveMainWindow"
    Deactivated="MainWindow_Deactivated"
    Closing="MainWindow_Closing"
    Loaded="MainWindow_Loaded"
>
    <Window.Resources>
        <!-- 动态页面切换按钮颜色 -->
        <SolidColorBrush x:Key="UnSelectedBrush" Color="{Binding ToolbarColor, Converter={StaticResource SmartHoverColorConverter}, Mode=OneWay}"/>
        <!-- 图片资源 -->
        <BitmapImage x:Key="UnpinFromDesktopSource" UriSource="pack://application:,,,/Resources/Images/UnpinFromDesktop.png"/>
        <BitmapImage x:Key="PinToDesktopSource" UriSource="pack://application:,,,/Resources/Images/PinToDesktop.png"/>
        <BitmapImage x:Key="UnLockIconSource" UriSource="pack://application:,,,/Resources/Images/UnLocked.png"/>
        <BitmapImage x:Key="LockIconSource" UriSource="pack://application:,,,/Resources/Images/Locked.png"/>
        <!-- 转换器 -->
        <conv:SmartHoverColorConverter x:Key="SmartHoverColorConverter" DarkerFactor="0.8" LighterFactor="1.2"/>
        <conv:PathToImageSourceConverter x:Key="PathToImageSourceConverter"/>
        <conv:IntToCornerRadiusConverter x:Key="IntToCornerRadiusConverter"/>
        <conv:ButtonBackgroundConverter x:Key="ButtonBackgroundConverter"/>
        <conv:BorderHeightConverter x:Key="BorderHeightConverter"/>
        <conv:BlurEffectConverter x:Key="BlurEffectConverter"/>
        <conv:GridHeightConverter x:Key="GridHeightConverter"/>
        <conv:FontWeightConverter x:Key="FontWeightConverter"/>
        <conv:GridWidthConverter x:Key="GridWidthConverter"/>
        <conv:ThicknessConverter x:Key="ThicknessConverter"/>
        <!-- 动作按钮模板 -->
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Foreground" Value="{Binding DataContext.ButtonTextColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderBrush" Value="{Binding BorderColor}"/>
            <Setter Property="FontWeight" Value="{Binding FontWeight}"/>
            <Setter Property="FontSize" Value="{Binding FontSize}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource ButtonBackgroundConverter}">
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="DataContext.ActionButtonColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.ActionButtonMouseOverColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.BlankButtonColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.BlankButtonMouseOverColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{Binding BorderWidth, Converter={StaticResource ThicknessConverter}}" Background="{TemplateBinding Background}" CornerRadius="{Binding ButtonCornerRadius}">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 标题栏Button -->
        <Style x:Key="Task" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding DataContext.ToolbarColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SmartHoverColorConverter}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.Height>
            <MultiBinding Converter="{StaticResource BorderHeightConverter}">
                <Binding Path="ButtonSize"/>
                <Binding Path="ButtonGap"/>
            </MultiBinding>
        </Grid.Height>
        <Grid.Width>
            <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                <Binding Path="ButtonSize"/>
                <Binding Path="ButtonGap"/>
            </MultiBinding>
        </Grid.Width>
        <!-- 窗口阴影 -->
        <Border x:Name="ShadowBorder" Margin="0.6" Background="#FFF3F3F3" CornerRadius="{Binding Win11CornerRadius, Converter={StaticResource IntToCornerRadiusConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <!-- Blur == 0: 有阴影，Opacity=1 -->
                        <DataTrigger Binding="{Binding Blur}" Value="0">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                        <!-- Blur == 1: 有阴影，Opacity=0.5 -->
                        <DataTrigger Binding="{Binding Blur}" Value="1">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#66000000" Direction="0" BlurRadius="30" RenderingBias="Quality" ShadowDepth="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                        <!-- Blur == 2: 无阴影，Opacity=1 -->
                        <DataTrigger Binding="{Binding Blur}" Value="2">
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                        <!-- Blur == 3: 无阴影，Opacity=0.5 -->
                        <DataTrigger Binding="{Binding Blur}" Value="3">
                            <Setter Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <!-- 窗口模糊 -->
        <Border x:Name="BlurBorder" Background="Transparent" CornerRadius="{Binding Win11CornerRadius, Converter={StaticResource IntToCornerRadiusConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <!-- Blur == 1: 有模糊 -->
                        <DataTrigger Binding="{Binding Blur}" Value="1">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="15"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                        <!-- Blur == 3: 有模糊 -->
                        <DataTrigger Binding="{Binding Blur}" Value="3">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="15"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <!-- 窗口内容 -->
        <Border x:Name="ViewBorder" CornerRadius="{Binding Win11CornerRadius, Converter={StaticResource IntToCornerRadiusConverter}}" Background="{Binding BackgroundColor}" helpers:ClipHelper.ClipToBounds="True">
            <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="31"/>
                    <RowDefinition Height="{Binding ElementName=GlobalGrid, Path=ActualHeight}"/>
                    <RowDefinition Height="25.5"/>
                    <RowDefinition Height="{Binding ElementName=CommonGrid, Path=ActualHeight}"/>
                </Grid.RowDefinitions>
                <!-- 背景图片 -->
                <Image x:Name="BackgroundImage" Stretch="Fill" Opacity="{Binding BackgroundImageOpacity}" Width="{Binding ActualWidth, ElementName=ViewBorder}" Height="{Binding ActualHeight, ElementName=ViewBorder}" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="0" Grid.RowSpan="4"/>
                <!-- 标题栏 -->
                <Grid x:Name="TitleBarGrid" Grid.RowSpan="1" Background="{Binding ToolbarColor}">
                    <Label Content="Quicker" Margin="2" Width="58" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13"/>
                    <Button Style="{StaticResource Task}" Click="OpenSettingWindow" ToolTip="打开设置窗口" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="58,0,0,0">
                        <Rectangle Width="16" Height="16" Fill="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Resources/Images/SettingImage2.png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                    <Button x:Name="ActionPageManager" Style="{StaticResource Task}" Click="OpenTitleMenu" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="82,0,0,0">
                        <Grid>
                            <Rectangle Width="16" Height="16" Fill="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Resources/Images/MoreSelection.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Border x:Name="HasNewVersionTip" CornerRadius="4" Background="#11AD45" Margin="12,12,0,0"/>
                        </Grid>
                    </Button>
                    <Popup x:Name="TitlePop" PopupAnimation="Fade" Width="180" Height="95" PlacementTarget="{Binding ElementName=ActionPageManager}" AllowsTransparency="True" StaysOpen="False">
                        <Grid>
                            <Border Background="White" CornerRadius="3" Margin="3">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFBBBBBB" Direction="0" BlurRadius="6" RenderingBias="Quality" ShadowDepth="1"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="White" CornerRadius="3" Margin="3" Padding="0,3">
                                <StackPanel>
                                    <Button Style="{StaticResource MenuButton}" ToolTip="为应用程序创建场景设置，管理动作页" Click="OpenActionPageManageWindow">
                                        <Grid Width="176">
                                            <Image Source="/Resources/Images/ActionPagesManager.jpg" Style="{StaticResource SelectButtonImage}"/>
                                            <TextBlock Text="场景与动作" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="UpdateButton" Style="{StaticResource MenuButton}" Click="UpdateQuicker">
                                        <Grid Width="176">
                                            <Image Source="/Resources/Images/Quicker_Enabled.png" Style="{StaticResource SelectButtonImage}"/>
                                            <TextBlock Text="升级Quicker" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                                        </Grid>
                                    </Button>
                                    <Rectangle Height="1" Width="176" Fill="#FFF0F0F0" Margin="0,3"/>
                                    <Button Style="{StaticResource MenuButton}" ToolTip="关闭Quicker软件" Click="QuitQuicker">
                                        <Grid Width="176">
                                            <Image Source="/Resources/Images/CloseQuicker.png" Style="{StaticResource SelectButtonImage}"/>
                                            <TextBlock Text="退出" TextAlignment="Left" Margin="26,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Popup>
                    <Button Style="{StaticResource Task}" Click="BookQuicker" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,0">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="订住：固定位置，不自动隐藏"/>
                                    <TextBlock Text="订住需点击×关闭窗口"/>
                                    <!--<TextBlock Text="右键点击可打开面板浮标"/>-->
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <Rectangle Width="20" Height="20" Fill="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="OpacityMask">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="{StaticResource UnpinFromDesktopSource}"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPinned, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="OpacityMask">
                                                <Setter.Value>
                                                    <ImageBrush ImageSource="{StaticResource PinToDesktopSource}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Button>
                    <Button Style="{StaticResource Task}" Click="HideMainWindow" ToolTip="关闭面板窗口" HorizontalAlignment="Right" Margin="0,0,3,0" AllowDrop="True" Drop="CloseMainWindowButton_Drop">
                        <Rectangle Width="20" Height="20" Fill="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Resources/Images/CloseWindow.png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                </Grid>
                <!-- 全局动作 -->
                <Grid x:Name="GlobalGrid" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.Row="1" MouseWheel="GlobalGrid_MouseWheel">
                    <Grid.Height>
                        <MultiBinding Converter="{StaticResource GridHeightConverter}" ConverterParameter="3">
                            <Binding Path="ButtonSize"/>
                            <Binding Path="ButtonGap"/>
                        </MultiBinding>
                    </Grid.Height>
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                            <Binding Path="ButtonSize"/>
                            <Binding Path="ButtonGap"/>
                        </MultiBinding>
                    </Grid.Width>
                </Grid>
                <!-- 功能栏 -->
                <Grid x:Name="FunctionBarGrid" VerticalAlignment="Center" Height="25" Grid.Row="2" Background="{Binding ToolbarColor}">
                    <TextBlock x:Name="CommonTextBlock" Text="默认" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}" TextAlignment="Center" MouseDown="CommonTextBlock_MouseDown" Margin="10,0" Cursor="Hand"/>
                    <StackPanel x:Name="GlobalButtonPanel" Margin="77.6,0,77.6,13" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="CommonButtonPanel" Margin="0,13,0,0" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    <Button x:Name="SearchButton" HorizontalAlignment="Right" Margin="0,0,58,0" Style="{StaticResource Task}" Click="SearchButton_Click" ToolTip="搜索">
                        <Rectangle Width="14" Height="14" Fill="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Rectangle.OpacityMask>
                                <!--<ImageBrush ImageSource="/Resources/Images/Search.png"/>-->
                                <ImageBrush/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                    <Button x:Name="ActionPageSelecter" HorizontalAlignment="Right" Margin="0,0,34,0" Style="{StaticResource Task}" Click="LockCommonActionPage" MouseRightButtonDown="OpenSelectActionPageMenu">
                        <Rectangle Width="14" Height="14" Fill="{Binding DataContext.ToolbarIconColor, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="OpacityMask">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="{StaticResource UnLockIconSource}"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="OpacityMask">
                                                <Setter.Value>
                                                    <ImageBrush ImageSource="{StaticResource LockIconSource}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="锁定/解锁动作页自动切换"/>
                                    <TextBlock Text="右键点击：切换应用动作页并锁定"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </Grid>
                <!-- 通用动作 -->
                <Grid x:Name="CommonGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="3" MouseWheel="CommonGrid_MouseWheel">
                    <Grid.Height>
                        <MultiBinding Converter="{StaticResource GridHeightConverter}" ConverterParameter="4">
                            <Binding Path="ButtonSize"/>
                            <Binding Path="ButtonGap"/>
                        </MultiBinding>
                    </Grid.Height>
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource GridWidthConverter}" ConverterParameter="4">
                            <Binding Path="ButtonSize"/>
                            <Binding Path="ButtonGap"/>
                        </MultiBinding>
                    </Grid.Width>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>